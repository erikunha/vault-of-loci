filters:
  and:
    - type == "concept"
    - '!file.inFolder("90_System/Templates")'
views:
  - type: table
    name: Mixed review
    order:
      - file.name
      - category
      - last_tested
      - score
    groupBy:
      property: category
      direction: ASC
    sort:
      - property: last_tested
        direction: ASC
