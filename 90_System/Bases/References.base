filters:
  and:
    - type == "reference"
    - '!file.inFolder("90_System/Templates")'
formulas:
  state: 'if(verified == true, "verified", "to check")'
views:
  - type: table
    name: References
    order:
      - file.name
      - subtype
      - year
      - formula.state
    sort:
      - property: year
        direction: DESC
