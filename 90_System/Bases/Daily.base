filters:
  and:
    - type == "daily"
    - '!file.inFolder("90_System/Templates")'
views:
  - type: table
    name: Study log
    order:
      - date
      - tracks
      - minutes
      - cards
    sort:
      - property: date
        direction: DESC
    limit: 14
    summaries:
      minutes: Sum
      cards: Sum
