filters:
  and:
    - type == "track"
    - '!file.inFolder("90_System/Templates")'
views:
  - type: table
    name: Active tracks
    filters:
      and:
        - status == "active"
    order:
      - file.name
      - kind
      - horizon
      - deadline
      - status
    sort:
      - property: deadline
        direction: ASC
  - type: table
    name: All tracks
    order:
      - file.name
      - kind
      - horizon
      - deadline
      - status
    sort:
      - property: order
        direction: ASC
